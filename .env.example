# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — Developers panel → Your integration → Credentials
# Leave empty during development to use the built-in mock payment flow
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Base URL of the site (used to build Mercado Pago back_urls/notification_url)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
